# Example environment configuration file
APP_NAME="Task Management API"
API_V1_PREFIX="/api/v1"
DEBUG=True

# MongoDB 配置
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="task_manager_db"

# Redis 配置
REDIS_URL="redis://localhost:6379/0"

# 文件存储配置
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=10485760 

# 安全配置
SECRET_KEY="generate-a-secure-random-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时

# Git凭证加密密钥 (重要：在生产环境中必须修改此值！)
ENCRYPTION_KEY="generate-a-secure-key-using-cryptography"

# ChromaDB 配置
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_CODE="code_embeddings"
CHROMA_COLLECTION_DOCS="doc_embeddings"
